{
  "entry": "main.py",
  "name": "CAgent",
  "display_name": "CAgent",
  "version": "1.0.0",
  "icon": "assets/icon.png",
  "pyinstaller": {
    "onefile": true,
    "windowed": true,
    "add_data": [
      "core:core"
    ],
    "clean": true,
    "noconfirm": true
  },
  "platforms": {
    "windows": {
      "inno_setup": {
        "create_desktop_icon": true,
        "create_start_menu_icon": true,
        "allow_run_after_install": true,
        "languages": [
          "chinesesimplified",
          "english"
        ]
      }
    }
  }
}