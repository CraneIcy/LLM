# AnythingLLM 环境变量示例
# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，不会进入仓库

# AnythingLLM 服务地址（默认本机 3001 端口）
ANYTHINGLLM_BASE_URL=http://localhost:3001

# API Key：AnythingLLM 界面 → 设置 → API 密钥 → 生成新的 API 密钥
ANYTHINGLLM_API_KEY=

# 可选：默认工作区 slug，留空则取工作区列表中的第一个
ANYTHINGLLM_WORKSPACE=

# 可选：MCP 服务监听端口与地址
MCP_PORT=8765
MCP_HOST=127.0.0.1
